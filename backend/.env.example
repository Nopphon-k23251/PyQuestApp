# Backend Configuration
PROJECT_NAME="PyQuest - Python Practice Platform"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
DATABASE_URL=sqlite:///./pyquest.db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Firebase Project Settings
FIREBASE_PROJECT_ID=nopphonapp-d0c5b
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Dev Auth Bypass (allows quick testing/dev without service account credentials)
DEV_AUTH_BYPASS=True

# Judge & Sandbox Limits
JUDGE_TIMEOUT_MS=2000
JUDGE_MEMORY_LIMIT_MB=128
MAX_UPLOAD_SIZE_BYTES=1048576

# Bootstrap Admins (comma-separated or list)
ADMIN_EMAILS=["admin@pyquest.com"]
